<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!-- Default: SQL Server Express on this computer, Windows authentication. -->
    <add name="StudentClubDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=StudentClubDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />

    <!-- Alternative: SQL Server LocalDB.
         To use it, comment out the <add> element above and un-comment this one.
    <add name="StudentClubDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StudentClubDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
</configuration>
